# Copy this file to ".env" and fill in your real values.
# ".env" should NEVER be committed to git or pasted into chat.

RESY_DB_HOST=localhost
RESY_DB_PORT=5432
RESY_DB_NAME=resy
RESY_DB_USER=your_readonly_user
RESY_DB_PASSWORD=your_password

# Optional: cap how many days back we pull, to keep first runs fast
RESY_EDA_LOOKBACK_DAYS=1095
